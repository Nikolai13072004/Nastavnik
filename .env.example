# Copy this file to .env and replace every placeholder locally.
# Never commit the resulting .env file.
DATABASE_URL=file:./dev.db
AUTH_SECRET=replace-with-a-long-random-value
APP_BASE_URL=http://localhost:3000
NEXTAUTH_URL=http://localhost:3000
AUTH_URL=http://localhost:3000
EMAIL_PROVIDER=stub

# Production SMTP values belong only in the deployment environment.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_TLS_SERVERNAME=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# MAX Mini App: server-only token, never prefix with NEXT_PUBLIC_.
# Leave empty until the bot is issued. /max can be previewed without it.
MAX_BOT_TOKEN=
# Public username without @. Used to reject a token belonging to a different bot.
MAX_BOT_USERNAME=se14424319_bot
MAX_CHAT_ENABLED=false
# Worker-only trusted internal web origin; never supplied by a chat message.
MAX_CHAT_INTERNAL_ORIGIN=http://web:3000
# Independent random secret (32+ base64url characters) for incoming webhook requests.
MAX_WEBHOOK_SECRET=

# AI stays closed unless an isolated Vedomo instance and approved document mapping exist.
MAX_VEDOMO_ENABLED=false
MAX_VEDOMO_COURSE_ID=
MAX_VEDOMO_ORIGIN=
MAX_VEDOMO_SERVICE_TOKEN=
# Enable only after the scoped Vedomo document import endpoint is installed.
MAX_VEDOMO_IMPORT_ENABLED=false
