# Copy to .env and fill in. The same file serves local dev and Docker; the
# defaults below are dev-friendly, the comments call out what to change for a
# Docker/production run.

# --- LLM --------------------------------------------------------------------
# Три режима работы:
#   api      - облачный API OpenRouter.
#   gigachat - облачный API GigaChat от Сбера, нужен отдельный доступ.
#   ollama   - локальная модель, запускается отдельно на порту 11434.
# Облачный провайдер получает вопрос и найденные фрагменты документа.
LLM_MODE=api

# OpenRouter (LLM_MODE=api)
API_KEY=your_openrouter_api_key_here
API_MODEL=qwen/qwen3-32b

# Ollama (LLM_MODE=ollama)
OLLAMA_MODEL=qwen3:8b

# GigaChat (LLM_MODE=gigachat)
# Authorization key и scope берутся из кабинета API. Не публикуйте ключ.
# Доступные модели и тариф зависят от аккаунта; проверьте их перед запуском.
# Для HTTPS используйте доверенные сертификаты. Инструкция MAX:
# docker/MAX_GIGACHAT.md. Не отключайте проверку TLS на публичном стенде.
GIGACHAT_AUTH_KEY=
GIGACHAT_BASE_URL=https://api.giga.chat/v1
GIGACHAT_CA_BUNDLE=
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_MODEL=GigaChat-2-Pro
# Запасные модели через запятую используются при 404 основной модели.
# Пустое значение отключает замену. В замерах качества замену выключайте.
GIGACHAT_MODEL_FALLBACKS=GigaChat-2-Pro,GigaChat-2-Max,GigaChat
# Модель для распознавания фото (вкладка «Материалы» -> загрузка по фото).
# В режиме gigachat картинка не уходит в зарубежный сервис.
GIGACHAT_VISION_MODEL=GigaChat-2-Max
GIGACHAT_VERIFY_SSL=true

# --- Database ---------------------------------------------------------------
# Local dev / CI default: SQLite file at ./data/app.db
# Docker compose overrides this to Postgres automatically (see docker-compose.yml).
# To point local dev at Postgres manually:
#   DATABASE_URL=postgresql+psycopg://vedomo:change-me@localhost:5432/vedomo
DATABASE_URL=sqlite:///./data/app.db

# Postgres credentials used by docker-compose (the `db` service and the
# backend's DATABASE_URL are built from these). Change the password for any
# real deployment.
POSTGRES_USER=vedomo
POSTGRES_PASSWORD=change-me
POSTGRES_DB=vedomo

# --- Auth -------------------------------------------------------------------
# REQUIRED in production (docker-compose refuses to start without it).
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# In dev/tests an insecure fallback key is used when this is empty.
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
# Access-token lifetime in minutes. 60*24*7 = 7 days.
JWT_EXPIRE_MINUTES=10080
# Set to true only when the frontend is served over HTTPS (marks the auth
# cookie Secure). Keep false for plain-HTTP localhost / docker-compose.
# In production behind HTTPS this MUST be true — the backend logs a warning
# at startup if it's false on a Postgres (prod-like) deployment.
AUTH_COOKIE_SECURE=false

# --- Email + account flows (Stage 23) --------------------------------------
# Public URL the app is served from. Used to build links in password-reset and
# email-verification messages. In production set this to your real https domain
# (e.g. https://vedomo.example), otherwise the emailed links point at localhost.
APP_BASE_URL=http://localhost:3000
# Delivery backend: "console" logs the link to stdout (dev/CI), "smtp" sends for
# real (production), "memory" is for tests only.
EMAIL_BACKEND=console
EMAIL_FROM=Ведомо <no-reply@vedomo.local>
# SMTP settings - only used when EMAIL_BACKEND=smtp. Fill these from your mail
# provider (Resend / Postmark / SES / university SMTP) for production.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# STARTTLS on port 587 (set SMTP_USE_TLS=true), OR implicit TLS on port 465
# (set SMTP_USE_SSL=true). Russian providers (Yandex/Mail.ru) use 465 + SSL.
SMTP_USE_TLS=true
SMTP_USE_SSL=false
# Both TLS modes verify the server certificate and hostname. For a private CA,
# install its certificate in the container trust store; do not disable TLS.
# EMAIL_BACKEND=console prints reset links: local development only.
# Monitor the sanitized `email_delivery_failed reason=...` error in API logs.
# SMTP acceptance is not proof of delivery to the recipient's inbox.

# --- Production deploy (docker-compose.prod.yml) ---------------------------
# Your public domain - point its A record at the server IP. Used by Caddy for
# HTTPS and to build email links. Required only for the production overlay.
DOMAIN=
# The prod overlay forces AUTH_COOKIE_SECURE=true and APP_BASE_URL=https://$DOMAIN,
# so you don't set those by hand. To send real emails in prod, set above:
#   EMAIL_BACKEND=smtp
# Example for Yandex 360 (mailbox on your domain):
#   SMTP_HOST=smtp.yandex.ru
#   SMTP_PORT=465
#   SMTP_USE_SSL=true
#   SMTP_USER=you@yourdomain.ru
#   SMTP_PASSWORD=<app password>
#   EMAIL_FROM=Ведомо <you@yourdomain.ru>

# --- Rate limiting (Stage 9a) ----------------------------------------------
# Per-IP limits on auth/chat/upload. Format: "<count>/<period>", e.g. "10/minute".
# Set RATE_LIMIT_ENABLED=false to disable entirely (the test suite does this).
RATE_LIMIT_ENABLED=true
RATE_LIMIT_LOGIN=10/minute
RATE_LIMIT_REGISTER=5/minute
RATE_LIMIT_CHAT=30/minute
RATE_LIMIT_UPLOAD=20/minute

# --- Server binding ---------------------------------------------------------
# Local dev keeps loopback; the backend container sets API_HOST=0.0.0.0 itself.
API_HOST=127.0.0.1
API_PORT=8000

# --- Frontend ---------------------------------------------------------------
# Backend URL the Next server proxies /api/* to. Local dev default is
# 127.0.0.1:8000; docker-compose builds the frontend with http://backend:8000.
VEDOMO_API_URL=http://127.0.0.1:8000
# Public origin used for metadata and link previews. Set the final HTTPS domain
# before building the production frontend image.
SITE_URL=http://localhost:3000
# Server-to-server imports stay closed unless enabled for the isolated MAX pilot.
PRODIGY_DOCUMENT_IMPORT_ENABLED=false
# OCR scans: keep the default conservative until the target server is measured.
# A scan above this limit is rejected explicitly and is never indexed partially.
OCR_PDF_MAX_PAGES=50
OCR_PDF_SCALE=2.0
# Retrieval models use CPU by default so ordinary VPS deployments remain
# portable. Set both to cuda only in an NVIDIA/CUDA image after a load test.
EMBEDDING_DEVICE=cpu
RERANKER_DEVICE=cpu
# Candidate pool checked by the reranker. Keep 80 until the exact same pilot
# questions pass a 20/40/80 comparison; a lower value trades recall for CPU.
RETRIEVAL_TOP_K=80
# Local CPU model scheduling. Interactive retrieval is prioritised between
# indexing batches/OCR pages; keep 1 on a small CPU VPS and raise only after a
# measured concurrency test.
MODEL_CHAT_CONCURRENCY=1
OCR_PDF_RECHECK_SCALE=4.0
# Sends only a suspicious page to the configured vision provider after two
# local OCR passes fail. Keep false for strict on-prem/private deployments.
OCR_VISION_RECHECK_ENABLED=false
RERANKER_MAX_LENGTH=256
# Optional Windows overrides. Linux/Docker normally discovers these itself.
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
# TESSDATA_PREFIX=C:\Users\YOUR_USER\AppData\Local\Vedomo\tessdata
