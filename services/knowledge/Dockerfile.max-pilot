# CPU-only backend for the MAX text-document pilot. No private base image.
FROM python:3.12-slim-bookworm@sha256:392307d22300de8b5986851a12d9176dfc0fc073e65bf6523ebd7dcbeb23564e

ENV PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    HF_HOME=/models \
    EMBEDDING_DEVICE=cpu \
    API_HOST=0.0.0.0 \
    API_PORT=8000

WORKDIR /app

RUN apt-get update \
    && apt-get install -y --no-install-recommends libgomp1 \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt requirements.max.lock ./
RUN python -m pip install --timeout 120 --retries 3 pip==26.2.1 \
    && python -m pip install --timeout 120 --retries 3 \
        --index-url https://download.pytorch.org/whl/cpu torch==2.14.0+cpu \
    && python -m pip install --timeout 120 --retries 3 \
        -r requirements.txt -c requirements.max.lock

COPY . .

RUN python -m pip check \
    && python -m compileall -q api_app.py config.py src scripts alembic \
    && chmod +x docker/entrypoint.sh

EXPOSE 8000
ENTRYPOINT ["docker/entrypoint.sh"]
