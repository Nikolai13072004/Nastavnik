# (run-infra-tests.mjs / migrate-sqlite-to-postgres.mjs); обычно чистятся сами,
# тут — страховка от жёсткого обрыва.
/prisma/schema.infra-pg-*.prisma
/prisma/schema.migrate-pg.prisma
/prisma/dev.db
/prisma/dev.db-journal
/prisma/dev.db-shm
/prisma/dev.db-wal
/prisma/e2e.db
/prisma/e2e.db-journal
/prisma/e2e.db-shm
/prisma/e2e.db-wal
/e2e.db
/e2e.db-journal
/e2e.db-shm
/e2e.db-wal
/public/uploads/*
