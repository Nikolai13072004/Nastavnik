{
  "openapi": "3.0.3",
  "info": {
    "title": "Prodigy MAX",
    "version": "2026-09-27",
    "description": "Публичный API основного учебного сценария. MAX подписывает запуск, HR выдаёт личный код. Сессия действует 15 минут и не является токеном бота или входом в веб-LMS. Все данные пилота вымышленные. Дополнительные служебные маршруты webhook и настройки интеграции не входят в этот проверочный контракт."
  },
  "servers": [
    {
      "url": "https://prodigy-max.45-139-78-17.sslip.io/api/max"
    }
  ],
  "security": [
    {
      "maxSession": []
    }
  ],
  "paths": {
    "/identity": {
      "post": {
        "operationId": "verifyIdentity",
        "summary": "Проверить настоящий запуск из MAX, при необходимости связать профиль",
        "responses": {
          "200": {
            "description": "Успешный результат",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Identity"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Error"
          },
          "401": {
            "$ref": "#/components/responses/Error"
          },
          "409": {
            "$ref": "#/components/responses/Error"
          },
          "413": {
            "$ref": "#/components/responses/Error"
          },
          "415": {
            "$ref": "#/components/responses/Error"
          },
          "429": {
            "description": "Лимит gateway"
          },
          "503": {
            "$ref": "#/components/responses/Error"
          }
        },
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "initData": {
                    "type": "string",
                    "minLength": 1,
                    "description": "Подписанные данные MAX Bridge. Не выдумывать и не публиковать."
                  },
                  "inviteToken": {
                    "type": "string",
                    "description": "Личный одноразовый код от HR."
                  }
                },
                "required": [
                  "initData"
                ]
              }
            }
          }
        }
      }
    },
    "/courses": {
      "get": {
        "operationId": "listCourses",
        "summary": "Назначенные действующие курсы",
        "responses": {
          "200": {
            "description": "Успешный результат",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Courses"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Error"
          },
          "429": {
            "description": "Лимит gateway"
          },
          "503": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/course": {
      "get": {
        "operationId": "readCourse",
        "summary": "Материалы, тесты и сохранённый прогресс курса",
        "responses": {
          "200": {
            "description": "Успешный результат",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Course"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Error"
          },
          "401": {
            "$ref": "#/components/responses/Error"
          },
          "403": {
            "$ref": "#/components/responses/Error"
          },
          "429": {
            "description": "Лимит gateway. Подождать, не повторять запись автоматически."
          },
          "503": {
            "$ref": "#/components/responses/Error"
          }
        },
        "parameters": [
          {
            "name": "courseId",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            }
          }
        ]
      },
      "post": {
        "operationId": "completeMaterial",
        "summary": "Подтвердить изучение доступного материала",
        "responses": {
          "200": {
            "description": "Успешный результат",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MaterialCompleted"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Error"
          },
          "401": {
            "$ref": "#/components/responses/Error"
          },
          "403": {
            "$ref": "#/components/responses/Error"
          },
          "404": {
            "$ref": "#/components/responses/Error"
          },
          "413": {
            "$ref": "#/components/responses/Error"
          },
          "415": {
            "$ref": "#/components/responses/Error"
          },
          "429": {
            "description": "Лимит gateway"
          },
          "503": {
            "$ref": "#/components/responses/Error"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "courseId": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 128
                  },
                  "materialId": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 128
                  }
                },
                "required": [
                  "courseId",
                  "materialId"
                ]
              }
            }
          }
        }
      }
    },
    "/quiz": {
      "post": {
        "operationId": "takeQuiz",
        "summary": "Начать или сдать тест",
        "responses": {
          "200": {
            "description": "Успешный результат",
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    {
                      "$ref": "#/components/schemas/QuizStart"
                    },
                    {
                      "$ref": "#/components/schemas/QuizResult"
                    }
                  ]
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Error"
          },
          "401": {
            "$ref": "#/components/responses/Error"
          },
          "403": {
            "$ref": "#/components/responses/Error"
          },
          "409": {
            "$ref": "#/components/responses/Error"
          },
          "415": {
            "$ref": "#/components/responses/Error"
          },
          "429": {
            "description": "Лимит gateway"
          },
          "503": {
            "$ref": "#/components/responses/Error"
          }
        },
        "description": "start возвращает существующую незавершённую попытку или создаёт новую. До начала нужен обязательный материал. submit с теми же ответами идемпотентен. answers: объект questionId: индекс ответа с нуля. Повторы без лимита доступны только демонстрационному тесту.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "oneOf": [
                  {
                    "type": "object",
                    "properties": {
                      "action": {
                        "type": "string",
                        "enum": [
                          "start"
                        ]
                      },
                      "courseId": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 128
                      },
                      "quizId": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 128
                      }
                    },
                    "required": [
                      "action",
                      "courseId",
                      "quizId"
                    ]
                  },
                  {
                    "type": "object",
                    "properties": {
                      "action": {
                        "type": "string",
                        "enum": [
                          "submit"
                        ]
                      },
                      "courseId": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 128
                      },
                      "quizId": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 128
                      },
                      "attemptId": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 128
                      },
                      "answers": {
                        "type": "object",
                        "additionalProperties": {
                          "type": "integer",
                          "minimum": 0
                        }
                      }
                    },
                    "required": [
                      "action",
                      "courseId",
                      "quizId",
                      "attemptId",
                      "answers"
                    ]
                  }
                ]
              }
            }
          }
        }
      }
    },
    "/knowledge": {
      "post": {
        "operationId": "askKnowledge",
        "summary": "Ответ AI по разрешённым источникам курса",
        "responses": {
          "200": {
            "description": "Успешный результат",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/KnowledgeAnswer"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Error"
          },
          "401": {
            "$ref": "#/components/responses/Error"
          },
          "403": {
            "$ref": "#/components/responses/Error"
          },
          "404": {
            "$ref": "#/components/responses/Error"
          },
          "415": {
            "$ref": "#/components/responses/Error"
          },
          "429": {
            "description": "Лимит AI или gateway"
          },
          "503": {
            "$ref": "#/components/responses/Error"
          }
        },
        "description": "refused=true с пустым sources - корректный отказ при отсутствии подтверждённого ответа. Это HTTP 200, не ошибка сервера. На пилоте подключён только один утверждённый источник.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "courseId": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 128,
                    "pattern": "^[A-Za-z0-9_-]{1,128}$"
                  },
                  "question": {
                    "type": "string",
                    "minLength": 3,
                    "maxLength": 500
                  }
                },
                "required": [
                  "courseId",
                  "question"
                ]
              }
            }
          }
        }
      }
    },
    "/documents": {
      "get": {
        "operationId": "readDocuments",
        "summary": "Документы курса, конкретный источник или его оригинал",
        "responses": {
          "200": {
            "description": "JSON-список/документ или байты оригинала. Для скачивания обязательны documentId и download=original.",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "type": "string",
                  "enum": [
                    "no-store"
                  ]
                }
              },
              "Content-Disposition": {
                "schema": {
                  "type": "string"
                },
                "description": "Только для скачивания, attachment с UTF-8 именем."
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DocumentListOrDetail"
                }
              },
              "application/pdf": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              },
              "text/plain": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Error"
          },
          "401": {
            "$ref": "#/components/responses/Error"
          },
          "403": {
            "$ref": "#/components/responses/Error"
          },
          "404": {
            "$ref": "#/components/responses/Error"
          },
          "429": {
            "description": "Лимит gateway"
          },
          "503": {
            "$ref": "#/components/responses/Error"
          }
        },
        "description": "documentId выбирает один документ. download=original возвращает его байты, только если оригинал сохранён. scope=manager требует текущих прав HR/руководителя своей организации и позволяет читать черновики. Поля внутреннего хранилища не выдаются.",
        "parameters": [
          {
            "name": "courseId",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            }
          },
          {
            "name": "documentId",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            }
          },
          {
            "name": "scope",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "manager"
              ]
            }
          },
          {
            "name": "download",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "original"
              ]
            }
          }
        ]
      },
      "post": {
        "operationId": "uploadDocument",
        "summary": "HR: загрузить TXT/MD/PDF как черновик",
        "responses": {
          "201": {
            "description": "status=CREATED",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Status"
                }
              }
            }
          },
          "400": {
            "description": "Ошибка разбора запроса или status=INVALID_INPUT",
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    { "$ref": "#/components/schemas/Error" },
                    { "$ref": "#/components/schemas/Status" }
                  ]
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Error"
          },
          "403": {
            "description": "status=FORBIDDEN",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Status"
                }
              }
            }
          },
          "404": {
            "description": "Курс недоступен: error=NOT_FOUND или status=NOT_FOUND",
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    { "$ref": "#/components/schemas/Error" },
                    { "$ref": "#/components/schemas/Status" }
                  ]
                }
              }
            }
          },
          "409": {
            "description": "status=LIMIT_REACHED или CONFLICT",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Status"
                }
              }
            }
          },
          "413": {
            "$ref": "#/components/responses/Error"
          },
          "415": {
            "$ref": "#/components/responses/Error"
          },
          "429": {
            "description": "Лимит gateway"
          },
          "503": {
            "$ref": "#/components/responses/Error"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "courseId": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 128
                  },
                  "title": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 120
                  },
                  "sourceName": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 120
                  },
                  "contentText": {
                    "type": "string"
                  },
                  "fileBase64": {
                    "type": "string",
                    "format": "byte"
                  },
                  "supersedesId": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 128
                  },
                  "changeSummary": {
                    "type": "string",
                    "maxLength": 500
                  },
                  "checkQuestion": {
                    "type": "string",
                    "maxLength": 240
                  },
                  "checkOptions": {
                    "type": "array",
                    "minItems": 3,
                    "maxItems": 3,
                    "items": {
                      "type": "string",
                      "minLength": 2,
                      "maxLength": 160
                    }
                  },
                  "checkCorrectIndex": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 2
                  }
                },
                "required": [
                  "courseId",
                  "title",
                  "sourceName"
                ],
                "oneOf": [
                  {
                    "required": [
                      "contentText"
                    ],
                    "not": {
                      "required": [
                        "fileBase64"
                      ]
                    }
                  },
                  {
                    "required": [
                      "fileBase64"
                    ],
                    "not": {
                      "required": [
                        "contentText"
                      ]
                    }
                  }
                ]
              }
            }
          }
        },
        "description": "TXT/MD: UTF-8 до 32 КиБ, ровно одно из contentText/fileBase64. PDF: только fileBase64, до 512 КиБ и 10 страниц с текстовым слоем. Извлечённый текст до 32 КиБ. Для редакции обязательны supersedesId и все поля проверки. Для первой версии поля редакции не передавать. AI автоматически не подключается."
      },
      "put": {
        "operationId": "publishDocument",
        "summary": "HR: опубликовать или отозвать документ",
        "responses": {
          "200": {
            "description": "status=UPDATED",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Status"
                }
              }
            }
          },
          "400": {
            "description": "Некорректный запрос или status=INVALID_INPUT",
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    {
                      "$ref": "#/components/schemas/Error"
                    },
                    {
                      "$ref": "#/components/schemas/Status"
                    }
                  ]
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Error"
          },
          "403": {
            "description": "status=FORBIDDEN",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Status"
                }
              }
            }
          },
          "404": {
            "description": "status=NOT_FOUND",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Status"
                }
              }
            }
          },
          "409": {
            "description": "status=AUDIENCE_CHANGED, AUDIENCE_TOO_LARGE или CONFLICT",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Status"
                }
              }
            }
          },
          "413": {
            "$ref": "#/components/responses/Error"
          },
          "415": {
            "$ref": "#/components/responses/Error"
          },
          "429": {
            "description": "Лимит gateway"
          },
          "503": {
            "$ref": "#/components/responses/Error"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "courseId": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 128
                  },
                  "documentId": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 128
                  },
                  "publish": {
                    "type": "boolean"
                  },
                  "expectedRecipientIds": {
                    "type": "array",
                    "maxItems": 200,
                    "uniqueItems": true,
                    "items": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 128
                    }
                  }
                },
                "required": [
                  "courseId",
                  "documentId",
                  "publish"
                ]
              }
            }
          }
        },
        "description": "Перед публикацией редакции передать список получателей из HR-просмотра. AUDIENCE_CHANGED требует обновить список, не повторять вслепую."
      }
    },
    "/manager-report": {
      "get": {
        "operationId": "readManagerReport",
        "summary": "HR: курсы, сотрудники и отчёт своей организации",
        "responses": {
          "200": {
            "description": "Успешный результат",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ManagerReport"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Error"
          },
          "401": {
            "$ref": "#/components/responses/Error"
          },
          "403": {
            "$ref": "#/components/responses/Error"
          },
          "404": {
            "$ref": "#/components/responses/Error"
          },
          "429": {
            "description": "Лимит gateway"
          },
          "503": {
            "$ref": "#/components/responses/Error"
          }
        },
        "parameters": [
          {
            "name": "courseId",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            }
          }
        ]
      },
      "post": {
        "operationId": "assignCourse",
        "summary": "HR: назначить существующему сотруднику курс",
        "responses": {
          "200": {
            "description": "Успешный результат",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Status"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Error"
          },
          "401": {
            "$ref": "#/components/responses/Error"
          },
          "403": {
            "description": "status=FORBIDDEN",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Status"
                }
              }
            }
          },
          "404": {
            "description": "status=NOT_FOUND",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Status"
                }
              }
            }
          },
          "413": {
            "$ref": "#/components/responses/Error"
          },
          "415": {
            "$ref": "#/components/responses/Error"
          },
          "429": {
            "description": "Лимит gateway"
          },
          "503": {
            "$ref": "#/components/responses/Error"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "courseId": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 128
                  },
                  "learnerId": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 128
                  }
                },
                "required": [
                  "courseId",
                  "learnerId"
                ]
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "maxSession": {
        "type": "http",
        "scheme": "bearer",
        "description": "session.token из POST /identity после настоящего запуска MAX и личной привязки. Срок 900 секунд. Повторно открыть приложение для обновления. Не использовать MAX_BOT_TOKEN или ключ Vedomo."
      }
